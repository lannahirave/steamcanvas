// Cloudflare Worker for the SteamCanvas fork used by Steam Artwork Studio.
// See docs/ARTWORK_STUDIO_INTEGRATION.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steamcanvas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker adds the security headers to every response, so it runs before static assets.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "previewartwork.lannahirave.com", "custom_domain": true }
  ],
  "vars": {
    "ARTWORK_STUDIO_ORIGIN": "https://artworkstudio.lannahirave.com"
  },
  // Serve only the custom domain, not a duplicate *.workers.dev copy.
  "workers_dev": false,
  "observability": { "enabled": true },
  "env": {
    // Beta: `npm run deploy:beta` (wrangler deploy --env beta). Vars and routes are not inherited,
    // so they are repeated here.
    "beta": {
      "name": "steamcanvas-beta",
      "routes": [
        { "pattern": "previewartwork-beta.lannahirave.com", "custom_domain": true }
      ],
      "workers_dev": false,
      "vars": {
        "ARTWORK_STUDIO_ORIGIN": "https://artworkstudio-beta.lannahirave.com",
        "DEMO_ARTWORK_ORIGIN": "https://demoartwork-beta.lannahirave.com",
        "ROBOTS_NOINDEX": "true"
      }
    }
  }
}
