// Cloudflare Worker for the SteamCanvas fork used by Steam Artwork Studio.
// See docs/ARTWORK_STUDIO_INTEGRATION.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steamcanvas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker. Other static assets are served directly, which does not count
    // toward the Workers request quota; their security headers come from dist/_headers, which
    // vite.config.ts generates from worker/securityHeaders.ts.
    "run_worker_first": ["/api", "/api/*", "/guides/*", "/bridge", "/bridge/*", "/robots.txt"]
  },
  "routes": [
    { "pattern": "previewartwork.lannahirave.com", "custom_domain": true }
  ],
  "vars": {
    "ARTWORK_STUDIO_ORIGIN": "https://artworkstudio.lannahirave.com"
  },
  // Shared catalog cache. Steam rate-limits Cloudflare's IPs on the Market, and the Cache API is
  // per data center, so the last good Market pages are kept here for every location to serve.
  "kv_namespaces": [
    { "binding": "CATALOG_KV", "id": "ed06ae5e7e944f45b0a3e3da70896670" }
  ],
  // No cron triggers. An hourly Market refresh used to run here; the picker now searches the cached
  // catalog (scripts/market-index.ts), so it only cost Steam requests and KV writes. An empty list
  // makes `wrangler deploy` remove existing triggers, which leaving the key out would not.
  "triggers": { "crons": [] },
  // Serve only the custom domain, not a duplicate *.workers.dev copy.
  "workers_dev": false,
  "observability": { "enabled": true },
  "env": {
    // Beta: `npm run deploy:beta` (wrangler deploy --env beta). Vars and routes are not inherited,
    // so they are repeated here.
    "beta": {
      "name": "steamcanvas-beta",
      "routes": [
        { "pattern": "previewartwork-beta.lannahirave.com", "custom_domain": true }
      ],
      "workers_dev": false,
      "vars": {
        "ARTWORK_STUDIO_ORIGIN": "https://artworkstudio-beta.lannahirave.com",
        "DEMO_ARTWORK_ORIGIN": "https://demoartwork-beta.lannahirave.com",
        "ROBOTS_NOINDEX": "true"
      },
      "kv_namespaces": [
        { "binding": "CATALOG_KV", "id": "b3b2387dc63c4a328ed899a65089218b" }
      ],
      "triggers": { "crons": [] }
    }
  }
}
