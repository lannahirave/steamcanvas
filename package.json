{
  "name": "steamcanvas",
  "author": {
    "name": "dumbapplee",
    "url": "https://github.com/dumbapplee"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:worker\" \"npm:dev:client\"",
    "dev:worker": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && wrangler dev --port 8790",
    "dev:client": "vite --host 0.0.0.0",
    "dev:node": "concurrently -k \"npm:dev:server\" \"npm:dev:client:node\"",
    "dev:client:node": "vite --host 0.0.0.0 --mode node",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.server.json && vite build",
    "build:beta": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.server.json && vite build --mode beta",
    "deploy": "npm run build && wrangler deploy",
    "deploy:beta": "npm run build:beta && wrangler deploy --env beta",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "cheerio": "^1.0.0",
    "express": "^5.1.0",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.2",
    "wrangler": "^4.156.0"
  }
}
